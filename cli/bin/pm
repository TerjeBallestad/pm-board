#!/usr/bin/env node
// pm 1.x: the pm commands, over HTTP to one server that holds every repo's board (DD-004,
// DD-021). lib/commands.js holds every command once; this file finds the command, checks its
// flags and runs it (DD-023, DD-025).
import { subcmd, positional, flags, VERSION, BOARD, usageError, requireBoard, loadConfig, loadConfigForHelp } from '../lib/runtime.js';
import { COMMANDS, GROUPS } from '../lib/commands.js';
import { renderUsage, renderCommandHelp, closest, GUESSES, FLAG_GUESSES } from '../lib/help.js';

// Flags every command takes: they pick the board, the server or the output.
const GLOBAL_FLAGS = ['board', 'server', 'help', 'json'];

// A hidden alias works, but neither the help nor "did you mean" names it (DD-028).
const byName = new Map();
for (const c of COMMANDS) for (const n of [c.name, ...(c.aliases || []), ...(c.hiddenAliases || [])]) byName.set(n, c);
const shown = [...byName.keys()].filter(n => !byName.get(n).hidden && !byName.get(n).hiddenAliases?.includes(n));

function suggestCommand(word) {
  const guess = GUESSES[String(word).toLowerCase()];
  if (guess) return guess;
  return closest(word, shown);
}

function unknownCommand(word) {
  const hint = suggestCommand(word);
  usageError(`Unknown command: ${word}.${hint ? ` Did you mean: pm ${hint}?` : ''}\nRun "pm help" to see every command.`);
}

function checkFlags(c) {
  if (c.anyFlags || c.fields?.(positional)) return;
  const known = [...(c.flags || []), ...GLOBAL_FLAGS];
  for (const f of Object.keys(flags)) {
    if (known.includes(f)) continue;
    const guess = FLAG_GUESSES[f];
    const hint = guess && known.includes(guess) ? guess : closest(f, known);
    const own = (c.flags || []).map(x => `--${x}`).join(', ') || 'none';
    usageError(`Unknown flag --${f} for pm ${c.name}.${hint ? ` Did you mean --${hint}?` : ''}\n` +
      `Flags of pm ${c.name}: ${own}. More: pm help ${c.name}`);
  }
}

async function main() {
  if (subcmd === '--version' || subcmd === '-v') {
    process.stdout.write(`pm ${VERSION}\n`);
    return;
  }
  if (!subcmd || subcmd === '--help' || subcmd === '-h' || (subcmd === 'help' && !positional[0])) {
    await loadConfigForHelp();
    process.stdout.write(renderUsage(COMMANDS, GROUPS));
    return;
  }
  if (subcmd === 'help') {
    const c = byName.get(positional[0]);
    if (!c) unknownCommand(positional[0]);
    if (c.removed) return c.run();
    await loadConfigForHelp();
    process.stdout.write(renderCommandHelp(c));
    return;
  }

  const command = byName.get(subcmd);
  if (!command) unknownCommand(subcmd);
  // A removed command names what to use instead, with any arguments and with --help (DD-028).
  if (command.removed) return command.run();
  if (flags.help === 'true') {
    await loadConfigForHelp();
    process.stdout.write(renderCommandHelp(command));
    return;
  }
  checkFlags(command);
  if (command.board !== false) {
    requireBoard();
    await loadConfig();
  }
  await command.run();
}

main();
